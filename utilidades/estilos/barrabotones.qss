/* Barra de botones lateral derecha */
#barraBotones {
    background-color: transparent;
}

/* Botones toggle */
#btnToggleMapeo,
#btnToggleFiltros,
#btnToggleFormulas,
#btnToggleDetectarCabeceras {
    background-color: transparent;
    color: #FFFFFF;
    border: 1px solid transparent;
    border-radius: 5px;
    padding: 2px 5px;
    text-align: left;
    font-family: Segoe UI;
    font-size: 11px;
    font-weight: 500;
}

#btnToggleMapeo:hover,
#btnToggleFiltros:hover,
#btnToggleFormulas:hover,
#btnToggleDetectarCabeceras:hover {
    background-color: #333337;
    border-color: #3E3E42;
}

#btnToggleMapeo:pressed,
#btnToggleFiltros:pressed,
#btnToggleFormulas:pressed,
#btnToggleDetectarCabeceras:pressed {
    background-color: #0D47A1;
    border-color: #0D47A1;
}

#btnToggleMapeo:focus,
#btnToggleFiltros:focus,
#btnToggleFormulas:focus,
#btnToggleDetectarCabeceras:focus {
    border-color: #64B5F6;
}

/* Estado activo (panel abierto) */
#btnToggleMapeo[activo="true"],
#btnToggleFiltros[activo="true"],
#btnToggleFormulas[activo="true"],
#btnToggleDetectarCabeceras[activo="true"] {
    background-color: #1976D2;
    border-color: #1976D2;
}

#btnToggleMapeo[activo="true"]:hover,
#btnToggleFiltros[activo="true"]:hover,
#btnToggleFormulas[activo="true"]:hover,
#btnToggleDetectarCabeceras[activo="true"]:hover {
    background-color: #1565C0;
    border-color: #1565C0;
}
