QLabel {
    background-color: transparent;
    padding: 0;
    margin: 0;
}

#topHeader {
    background-color: #FFFFFF;
    border-bottom: 1px solid #E5E7EB;
}

#mainTitle {
    font-family: Arial;
    font-size: 16px;
    font-weight: 600;
    color: #111827;
}

#subTitle {
    font-family: Arial;
    font-size: 11px;
    color: #6B7280;
}

#toolbarButton {
    background-color: transparent;
    border: none;
    border-radius: 6px;
    color: #374151;
    font-size: 11px;
    font-weight: 500;
    padding: 6px;
}

#toolbarButton:hover {
    background-color: #F3F4F6;
}

#toolbarButton:pressed {
    background-color: #E5E7EB;
}

/* --- Diálogos de la cabecera ---
   Heredan el fondo oscuro global (#333337 de ventana.qss), igual que el resto
   de la app: acá solo se ajustan los controles. --- */

#dialogoCargarAyuda {
    font-family: Segoe UI;
    font-size: 12px;
    color: #B0B0B0;
}

#dialogoCargarDetalle {
    font-family: Segoe UI;
    font-size: 11px;
    color: #8A8A8A;
}

#listaProyectos {
    background-color: #252526;
    border: 1px solid #3E3E42;
    border-radius: 6px;
    font-family: Segoe UI;
    font-size: 13px;
    color: #FFFFFF;
    padding: 4px;
    outline: none;
}

#listaProyectos::item {
    padding: 8px 10px;
    border-radius: 4px;
}

#listaProyectos::item:hover {
    background-color: #333337;
}

#listaProyectos::item:selected {
    background-color: #1976D2;
    color: #FFFFFF;
}

#btnDialogoPrimario {
    background-color: #1976D2;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    padding: 8px 18px;
    font-family: Segoe UI;
    font-size: 13px;
    font-weight: 500;
}

#btnDialogoPrimario:hover {
    background-color: #1565C0;
}

#btnDialogoPrimario:pressed {
    background-color: #0D47A1;
}

#btnDialogoPrimario:disabled {
    background-color: #37373A;
    color: #6D6D6D;
}

#btnDialogoSecundario {
    background-color: transparent;
    color: #FFFFFF;
    border: 1px solid #3E3E42;
    border-radius: 6px;
    padding: 8px 18px;
    font-family: Segoe UI;
    font-size: 13px;
    font-weight: 500;
}

#btnDialogoSecundario:hover {
    background-color: #333337;
    border-color: #1976D2;
}

#btnDialogoSecundario:pressed {
    background-color: #2D2D30;
}

#btnDialogoSecundario:disabled {
    color: #6D6D6D;
    border-color: #333337;
}

/* Acción destructiva: solo en el popup de limpieza */
#btnDialogoPeligro {
    background-color: #DC2626;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    padding: 8px 18px;
    font-family: Segoe UI;
    font-size: 13px;
    font-weight: 500;
}

#btnDialogoPeligro:hover {
    background-color: #B91C1C;
}

#btnDialogoPeligro:pressed {
    background-color: #991B1B;
}

#btnDialogoPeligro:disabled {
    background-color: #37373A;
    color: #6D6D6D;
}

/* --- Popup «Limpiar archivos guardados» --- */
#dialogoLimpiarAyuda {
    font-family: Segoe UI;
    font-size: 12px;
    color: #B0B0B0;
}

#dialogoLimpiarResumen {
    font-family: Segoe UI;
    font-size: 12px;
    font-weight: 600;
    color: #FFFFFF;
}

#separadorDialogo {
    color: #3E3E42;
    background-color: #3E3E42;
    max-height: 1px;
}

#comboLimpiar {
    background-color: #1E1E1E;
    border: 1px solid #3E3E42;
    border-radius: 6px;
    padding: 6px 10px;
    font-family: Segoe UI;
    font-size: 13px;
    color: #FFFFFF;
}

#comboLimpiar:focus {
    border-color: #1976D2;
}

#comboLimpiar::drop-down {
    border: none;
    width: 22px;
}

#comboLimpiar QAbstractItemView {
    background-color: #252526;
    border: 1px solid #3E3E42;
    color: #FFFFFF;
    selection-background-color: #1976D2;
    outline: none;
}

#listaLimpiar {
    background-color: #252526;
    border: 1px solid #3E3E42;
    border-radius: 6px;
    font-family: Segoe UI;
    font-size: 12px;
    color: #FFFFFF;
    padding: 4px;
    outline: none;
}

#listaLimpiar::item {
    padding: 6px 4px;
    border-radius: 4px;
}

#listaLimpiar::item:hover {
    background-color: #333337;
}

#listaLimpiar::item:selected {
    background-color: #333337;
    color: #FFFFFF;
}

/* --- Exportar análisis --- */
#dialogoExportar {
    background-color: #333337;
}

#tituloDialogoExportar {
    font-family: Segoe UI;
    font-size: 20px;
    font-weight: 700;
    color: #FFFFFF;
}

#subtituloDialogoExportar {
    font-family: Segoe UI;
    font-size: 12px;
    color: #B0B0B0;
}

#archivoSimpleExportacion {
    background-color: #2D2D30;
    border: 1px solid #3E3E42;
    border-radius: 5px;
    padding: 8px 10px;
    font-family: Segoe UI;
    font-size: 11px;
    color: #B0B0B0;
}

#seccionDialogoExportar {
    font-family: Segoe UI;
    font-size: 12px;
    font-weight: 600;
    color: #E0E0E0;
}

#opcionExportacion,
#opcionAlcanceExportacion {
    spacing: 9px;
    font-family: Segoe UI;
    font-size: 13px;
    font-weight: 600;
    color: #FFFFFF;
}

#opcionExportacion:disabled,
#opcionAlcanceExportacion:disabled {
    color: #77777D;
}

#opcionExportacion::indicator,
#opcionAlcanceExportacion::indicator {
    width: 16px;
    height: 16px;
    border-radius: 9px;
}

#opcionExportacion::indicator:unchecked,
#opcionAlcanceExportacion::indicator:unchecked {
    background-color: transparent;
    border: 2px solid #77777D;
}

#opcionExportacion::indicator:unchecked:hover,
#opcionAlcanceExportacion::indicator:unchecked:hover {
    border-color: #A8A8AD;
}

#opcionExportacion::indicator:checked,
#opcionAlcanceExportacion::indicator:checked {
    background-color: #1976D2;
    border: 4px solid #A9D0F5;
}

#opcionExportacion::indicator:disabled,
#opcionAlcanceExportacion::indicator:disabled {
    background-color: #2D2D30;
    border: 2px solid #4A4A4E;
}

#detalleOpcionExportacion,
#detalleOpcionExportacionDeshabilitada {
    font-family: Segoe UI;
    font-size: 11px;
    color: #A8A8AD;
}

#listaRecortesExportacion {
    background-color: #252526;
    border: 1px solid #3E3E42;
    border-radius: 5px;
    color: #E8E8E8;
    font-family: Segoe UI;
    font-size: 11px;
    outline: none;
}

#listaRecortesExportacion::item {
    padding: 5px 6px;
}

#listaRecortesExportacion:disabled {
    background-color: #2D2D30;
}

#catalogoCompletoExportacion {
    color: #D8D8D8;
    font-family: Segoe UI;
    font-size: 10px;
    font-weight: 600;
}

#btnAlcanceExportacion {
    background-color: #2D2D30;
    border: 1px solid #4A4A4E;
    border-radius: 4px;
    padding: 4px 12px;
    color: #D8D8D8;
    font-family: Segoe UI;
    font-size: 10px;
}

#btnAlcanceExportacion:hover {
    background-color: #3A3A3E;
    border-color: #66666B;
}

#btnAlcanceExportacion:disabled {
    color: #66666B;
    background-color: #2A2A2D;
    border-color: #3A3A3D;
}

#detalleAlcanceExportacion {
    color: #A8A8AD;
    font-family: Segoe UI;
    font-size: 10px;
}

#detalleOpcionExportacionDeshabilitada {
    font-style: italic;
    color: #66666B;
}

#notaSimpleExportacion {
    background-color: #2D2D30;
    border-left: 3px solid #1976D2;
    padding: 7px 8px;
    font-family: Segoe UI;
    font-size: 10px;
    color: #A8A8AD;
}

/* --- Confirmación de exportación --- */
#dialogoExportacionCompletada {
    background-color: #333337;
}

#iconoExportacionCompletada {
    background-color: #29452F;
    border: 1px solid #388E3C;
    border-radius: 23px;
    font-family: Segoe UI;
    font-size: 24px;
    font-weight: 700;
    color: #66BB6A;
}

#tituloExportacionCompletada {
    font-family: Segoe UI;
    font-size: 20px;
    font-weight: 700;
    color: #FFFFFF;
}

#subtituloExportacionCompletada {
    font-family: Segoe UI;
    font-size: 12px;
    color: #B0B0B0;
}

#fichaArchivoExportado {
    background-color: #252526;
    border: 1px solid #3E3E42;
    border-radius: 7px;
}

#tipoArchivoExportado {
    font-family: Segoe UI;
    font-size: 11px;
    font-weight: 600;
    color: #A8A8AD;
}

#formatoArchivoExportado {
    background-color: #1F5F9F;
    border: 1px solid #2E78BD;
    border-radius: 4px;
    padding: 2px 7px;
    font-family: Segoe UI;
    font-size: 9px;
    font-weight: 700;
    color: #FFFFFF;
}

#nombreArchivoExportado {
    font-family: Segoe UI;
    font-size: 15px;
    font-weight: 600;
    color: #FFFFFF;
}

#detalleArchivoExportado {
    font-family: Segoe UI;
    font-size: 11px;
    color: #B0B0B0;
}

#rutaArchivoExportado {
    background-color: #1E1E1E;
    border: 1px solid #3E3E42;
    border-radius: 5px;
    padding: 7px 9px;
    font-family: Consolas;
    font-size: 10px;
    color: #D0D0D0;
    selection-background-color: #1976D2;
    selection-color: #FFFFFF;
}

#rutaArchivoExportado:focus {
    border-color: #1976D2;
}

#estadoAperturaExportacion {
    background-color: #3A3024;
    border-left: 3px solid #D6A84B;
    padding: 7px 8px;
    font-family: Segoe UI;
    font-size: 10px;
    color: #D8C08A;
}
