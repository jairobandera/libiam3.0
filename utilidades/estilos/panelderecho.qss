/* Panel derecho completo */
#panelDerecho {
    background-color: #2D2D30;
    border-left: 3px solid #3E3E42;
}

#panelDerecho:hover {
    border-left-color: #1976D2;
}

/* Boton toggle del panel */
#btnTogglePanel {
    background-color: #252526;
    color: #B0B0B0;
    border: 1px solid #3E3E42;
    border-radius: 0;
    padding: 0;
    margin: 0;
}

#btnTogglePanel:hover {
    background-color: #333337;
    color: #FFFFFF;
}

#btnTogglePanel:pressed {
    background-color: #1E1E1E;
}

/* Configuracion de columnas */
#configColumnas {
    background-color: #2D2D30;
}

#filtrosPanel {
    background-color: #2D2D30;
}

/* Titulos */
#tituloPanel {
    font-family: Arial;
    font-size: 14px;
    font-weight: 600;
    color: #FFFFFF;
}

#subtituloPanel {
    font-family: Segoe UI;
    font-size: 11px;
    color: #808080;
}

/* Seccion de deteccion */
#seccionDeteccion {
    background-color: #252526;
    border: 1px solid #3E3E42;
    border-radius: 6px;
}

#lblDeteccion {
    color: #B0B0B0;
    font-family: Segoe UI;
    font-size: 12px;
}

#lblDeteccionOk {
    color: #4CAF50;
    font-family: Segoe UI;
    font-size: 12px;
}

#lblDeteccionWarn {
    color: #FF9800;
    font-family: Segoe UI;
    font-size: 12px;
}

#btnRedetectar {
    background-color: transparent;
    color: #FFFFFF;
    border: 1px solid #3E3E42;
    border-radius: 4px;
    padding: 6px 12px;
    font-family: Segoe UI;
    font-size: 12px;
}

#btnRedetectar:hover {
    background-color: #333337;
    border-color: #1976D2;
}

/* Seccion de mapeo */
#seccionMapeo {
    background-color: #252526;
    border: 1px solid #3E3E42;
    border-radius: 6px;
}

#seccionFiltro {
    background-color: #252526;
    border: 1px solid #3E3E42;
    border-radius: 6px;
}

#seccionFiltro QLabel {
    background-color: transparent;
}

#cmbSenalFiltro,
#cmbFiltro,
#spinFiltro {
    min-height: 26px;
    background-color: #333337;
    color: #FFFFFF;
    border: 1px solid #4A4A4F;
    border-radius: 4px;
    padding: 3px 7px;
    font-family: Segoe UI;
    font-size: 12px;
}

#cmbSenalFiltro:focus,
#cmbFiltro:focus,
#spinFiltro:focus {
    border-color: #42A5F5;
}

#cmbSenalFiltro::drop-down,
#cmbFiltro::drop-down {
    border: none;
    width: 22px;
}

#lblFrecuenciaFiltro {
    color: #90CAF9;
    background-color: #1E2A35;
    border: 1px solid #2C4F6B;
    border-radius: 4px;
    padding: 7px;
    font-family: Segoe UI;
    font-size: 11px;
}

#resumenFiltro {
    color: #DDE7EF;
    background-color: #30343A;
    border-left: 3px solid #42A5F5;
    padding: 8px;
    font-family: Segoe UI;
    font-size: 12px;
}

#resumenFiltro[valido="false"] {
    color: #FFCDD2;
    border-left-color: #EF5350;
}

#btnToggleSubintervalos {
    background-color: transparent;
    color: #B0B0B0;
    border: none;
    font-size: 12px;
    padding: 0;
    min-width: 16px;
    max-width: 16px;
}

#btnToggleSubintervalos:hover {
    color: #FFFFFF;
}

/* Botón de selección activo (Todos / Pares / Impares / Ninguno).
   La propiedad «activo» la fija Formulas._marcar_modo_seleccion(). */
#btnResetMapeo[activo="true"] {
    border: 1px solid #42A5F5;
    color: #FFFFFF;
    background-color: #2A3F55;
}

/* --- Recuadro de fórmulas dentro de «Intervalos para cálculos» --- */
#seccionFormulas {
    background-color: #2D2D30;
    border: 1px solid #3E3E42;
    border-radius: 6px;
}

#comboFormula {
    background-color: #1E1E1E;
    color: #FFFFFF;
    border: 1px solid #3E3E42;
    border-radius: 4px;
    padding: 5px 8px;
    font-size: 12px;
}

#comboFormula:focus {
    border-color: #1976D2;
}

#comboFormula:disabled {
    color: #6D6D6D;
    background-color: #252526;
    border-color: #333337;
}

#comboFormula QAbstractItemView {
    background-color: #252526;
    border: 1px solid #3E3E42;
    color: #FFFFFF;
    selection-background-color: #1976D2;
    outline: none;
}

#lblExpresionFormula {
    color: #B0B0B0;
    font-size: 11px;
}

#lblEstadoFormula {
    font-size: 11px;
}

#lblResultadosFormula {
    background-color: #252526;
    border: 1px solid #3E3E42;
    border-radius: 4px;
    color: #E0E0E0;
    font-size: 11px;
    padding: 6px 8px;
}

/* --- Popup de fórmulas avanzadas --- */
#tituloSeccionFormula {
    color: #B0B0B0;
    font-size: 12px;
    font-weight: 600;
}

#lblVariablesFormula {
    background-color: #252526;
    border: 1px solid #3E3E42;
    border-radius: 4px;
    color: #E0E0E0;
    font-size: 11px;
    padding: 6px 8px;
}

#tarjetaConstructorFormula QLabel#lblValidacionFormula {
    color: #B0B0B0;
    font-size: 11px;
}

#tarjetaConstructorFormula QLabel#lblValidacionFormula[estado="ok"] {
    color: #66BB6A;
}

#tarjetaConstructorFormula QLabel#lblValidacionFormula[estado="error"] {
    color: #EF5350;
}

QDialog#constructorFormulaDialog {
    background-color: #2D2D30;
    font-family: Segoe UI;
}

#encabezadoConstructorFormula,
#pieConstructorFormula {
    background-color: #2D2D30;
    border: none;
}

#encabezadoConstructorFormula {
    border-bottom: 1px solid #3E3E42;
}

#pieConstructorFormula {
    border-top: 1px solid #3E3E42;
}

#encabezadoConstructorFormula QLabel,
#pieConstructorFormula QLabel,
#tarjetaConstructorFormula QLabel,
#cuerpoConstructorFormula,
#columnaConstructorFormula,
#filaUnidadFormula {
    background-color: transparent;
}

#cuerpoConstructorFormula {
    background-color: #2D2D30;
}

#scrollEditorFormula,
#viewportEditorFormula {
    background-color: transparent;
    border: none;
}

#tituloConstructorFormula {
    color: #FFFFFF;
    font-size: 18px;
    font-weight: 600;
}

#subtituloConstructorFormula,
#ayudaConstructorFormula {
    color: #B0B0B0;
    font-size: 11px;
}

#tarjetaConstructorFormula {
    background-color: #252526;
    border: 1px solid #3E3E42;
    border-radius: 6px;
}

#tituloTarjetaFormula {
    color: #B0B0B0;
    font-size: 12px;
    font-weight: 600;
}

#tarjetaConstructorFormula QLabel#pasoConstructorFormula {
    color: #B0B0B0;
    font-size: 12px;
    font-weight: 600;
    min-width: 14px;
}

#etiquetaCampoFormula,
#etiquetaGrupoFormula {
    color: #D0D0D0;
    font-size: 11px;
    font-weight: 600;
}

#inputFormula,
#inputExpresionFormula {
    background-color: #1E1E1E;
    color: #FFFFFF;
    border: 1px solid #3E3E42;
    border-radius: 4px;
    padding: 7px 9px;
    font-family: Consolas;
    font-size: 13px;
    selection-background-color: #1976D2;
    selection-color: #FFFFFF;
}

#inputFormula:focus,
#inputExpresionFormula:focus {
    border-color: #1976D2;
}

#comboUnidadFormula,
#comboConstructorFormula {
    background-color: #1E1E1E;
    color: #FFFFFF;
    border: 1px solid #3E3E42;
    border-radius: 4px;
    padding: 6px 8px;
    font-size: 12px;
}

#comboUnidadFormula:focus,
#comboConstructorFormula:focus {
    border-color: #42A5F5;
}

#comboUnidadFormula QLineEdit {
    background-color: transparent;
    border: none;
    color: #FFFFFF;
    padding: 0;
}

#comboUnidadFormula QAbstractItemView,
#comboConstructorFormula QAbstractItemView {
    background-color: #252526;
    border: 1px solid #3E3E42;
    color: #FFFFFF;
    selection-background-color: #1976D2;
}

#btnSimboloUnidad {
    background-color: #333337;
    color: #FFFFFF;
    border: 1px solid #454549;
    border-radius: 4px;
    padding: 6px;
    min-width: 24px;
    max-width: 28px;
}

#btnSimboloUnidad:hover,
#btnSimboloUnidad:focus {
    background-color: #3D4F63;
    border-color: #42A5F5;
}

#tarjetaConstructorFormula QLabel#detalleCalculoReutilizable {
    background-color: #252526;
    border: 1px solid #3E3E42;
    border-radius: 4px;
    color: #D7D7D7;
    padding: 7px 9px;
    font-family: Consolas;
    font-size: 11px;
}

#tabsConstructorFormula {
    background-color: transparent;
}

#tabsConstructorFormula::pane {
    background-color: #252526;
    border: 1px solid #3E3E42;
    border-radius: 4px;
    top: -1px;
}

#tabsConstructorFormula QTabBar::tab {
    background-color: #2D2D30;
    border: 1px solid #3E3E42;
    color: #B0B0B0;
    font-size: 11px;
    padding: 7px 8px;
}

#tabsConstructorFormula QTabBar::tab:hover {
    background-color: #333337;
    border-color: #1976D2;
    color: #FFFFFF;
}

#tabsConstructorFormula QTabBar::tab:selected {
    background-color: #333337;
    border-bottom-color: #333337;
    color: #FFFFFF;
}

#scrollPaletaFormula,
#viewportPaletaFormula,
#contenidoTabFormula {
    background-color: #252526;
    border: none;
}

#vistaFormula {
    background-color: #252526;
    color: #E0E0E0;
    border: 1px solid #3E3E42;
    border-radius: 4px;
}

#btnPiezaFormula {
    background-color: #333337;
    color: #FFFFFF;
    border: 1px solid #454549;
    border-radius: 4px;
    padding: 7px 10px;
    min-width: 52px;
}

#btnPiezaFormula:hover {
    background-color: #3D4F63;
    border-color: #1976D2;
}

#btnPiezaFormula:pressed {
    background-color: #1976D2;
}

#btnPiezaFormula:focus {
    border-color: #42A5F5;
}

#btnPlantillaFormula,
#btnCancelarFormula {
    background-color: transparent;
    color: #FFFFFF;
    border: 1px solid #3E3E42;
    border-radius: 4px;
    padding: 8px 12px;
    font-family: Segoe UI;
    font-size: 12px;
}

#btnPlantillaFormula:hover,
#btnPlantillaFormula:focus,
#btnCancelarFormula:hover,
#btnCancelarFormula:focus {
    background-color: #333337;
    border-color: #1976D2;
}

#btnInsertarCalculoFormula,
#btnGuardarFormula {
    background-color: #1976D2;
    color: #FFFFFF;
    border: none;
    border-radius: 4px;
    padding: 8px 12px;
    font-family: Segoe UI;
    font-size: 12px;
    font-weight: 500;
}

#btnInsertarCalculoFormula:hover,
#btnGuardarFormula:hover {
    background-color: #1565C0;
}

#btnInsertarCalculoFormula:pressed,
#btnGuardarFormula:pressed {
    background-color: #0D47A1;
}

#btnInsertarCalculoFormula:disabled,
#btnGuardarFormula:disabled {
    background-color: #454549;
    color: #898989;
}

#chkFormulaReutilizable {
    color: #B0B0B0;
    font-family: Segoe UI;
    font-size: 12px;
}

#estadoGuardadoFormula {
    color: #B0B0B0;
    font-size: 11px;
}

#estadoGuardadoFormula[estado="ok"] {
    color: #66BB6A;
}

#estadoGuardadoFormula[estado="error"] {
    color: #EF5350;
}

#tablaResultados {
    background-color: #252526;
    alternate-background-color: #2D2D30;
    border: 1px solid #3E3E42;
    border-radius: 4px;
    color: #FFFFFF;
    font-size: 12px;
    gridline-color: #3E3E42;
    outline: none;
}

#tablaResultados::item {
    padding: 4px 6px;
}

#tablaResultados::item:selected {
    background-color: #1976D2;
}

#tablaResultados QHeaderView::section {
    background-color: #2D2D30;
    color: #B0B0B0;
    border: none;
    border-bottom: 1px solid #3E3E42;
    padding: 6px;
    font-weight: 600;
}

/* Botón de nota del intervalo (el color lo trae el propio icono SVG:
   gris con "+" = sin nota, azul relleno = con nota) */
#btnNotaIntervalo {
    background-color: transparent;
    border: none;
    border-radius: 3px;
    padding: 1px;
    min-width: 20px;
    max-width: 22px;
}

#btnNotaIntervalo:hover {
    background-color: #37373A;
}

#btnNotaIntervalo:pressed {
    background-color: #2D2D30;
}

/* Botones para eliminar intervalos y sub-intervalos.
   «✕» sola siempre borra el ítem de esa fila (intervalo o sub-intervalo); «↳✕»
   solo aparece en un intervalo con sub-intervalos y borra únicamente esos hijos. */
#btnEliminarSubintervalo,
#btnEliminarTodosSubintervalos,
#btnEliminarIntervalo {
    background-color: transparent;
    color: #8A8A8A;
    border: none;
    font-size: 12px;
    font-weight: 600;
    padding: 0 2px;
}

#btnEliminarSubintervalo,
#btnEliminarIntervalo {
    min-width: 20px;
    max-width: 22px;
}

#btnEliminarTodosSubintervalos {
    min-width: 26px;
    max-width: 30px;
}

#btnEliminarSubintervalo:hover,
#btnEliminarTodosSubintervalos:hover {
    color: #EF5350;
}

/* El borrado de intervalo completo es más destructivo (se lleva los
   sub-intervalos): marco visible además del color en hover. */
#btnEliminarIntervalo {
    border-radius: 3px;
}

#btnEliminarIntervalo:hover {
    color: #EF5350;
    background-color: rgba(239, 83, 80, 0.15);
}

#chkRecorteTodas {
    color: #DDE7EF;
    font-family: Segoe UI;
    font-size: 12px;
    padding: 2px 0;
}

#tituloSeccionMapeo {
    font-family: Arial;
    font-size: 12px;
    font-weight: 600;
    color: #B0B0B0;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

#lblTipoDato {
    color: #B0B0B0;
    font-family: Segoe UI;
    font-size: 12px;
}

#cmbTipoDato {
    background-color: #333337;
    color: #FFFFFF;
    border: 1px solid #3E3E42;
    border-radius: 4px;
    padding: 4px 8px;
    font-family: Segoe UI;
    font-size: 12px;
}

#cmbTipoDato::drop-down {
    border: none;
    width: 20px;
}

/* Ayuda de reordenamiento */
#lblAyudaOrden {
    color: #808080;
    font-family: Segoe UI;
    font-size: 11px;
    font-style: italic;
}

/* Lista de mapeo reordenable */
#listaMapeo {
    background-color: #1E1E1E;
    border: 1px solid #3E3E42;
    border-radius: 4px;
    outline: none;
    color: #FFFFFF;
    font-family: Segoe UI;
    font-size: 12px;
}

#listaMapeo::item {
    background-color: #2A2A2D;
    border: 1px solid #3E3E42;
    border-radius: 4px;
    padding: 7px 6px;
    margin: 1px;
}

#listaMapeo::item:hover {
    background-color: #333337;
    border-color: #1976D2;
}

#listaMapeo::item:selected {
    background-color: #2A2A2D;
    border-color: #1976D2;
    color: #FFFFFF;
}

/* Filas de mapeo */
#filaMapeo {
    background-color: transparent;
}

#lblEje {
    color: #FFFFFF;
    font-family: Segoe UI;
    font-size: 12px;
}

#filaMapeo QComboBox {
    background-color: #333337;
    color: #FFFFFF;
    border: 1px solid #3E3E42;
    border-radius: 4px;
    padding: 4px 8px;
    font-family: Segoe UI;
    font-size: 12px;
}

#filaMapeo QCheckBox {
    color: #B0B0B0;
    font-family: Segoe UI;
    font-size: 12px;
}

/* Botones de accion */
#btnAplicarMapeo {
    background-color: #1976D2;
    color: #FFFFFF;
    border: none;
    border-radius: 4px;
    padding: 8px 12px;
    font-family: Segoe UI;
    font-size: 12px;
    font-weight: 500;
}

#btnAplicarMapeo:hover {
    background-color: #1565C0;
}

#btnAplicarMapeo:pressed {
    background-color: #0D47A1;
}

#btnAplicarMapeo:disabled {
    background-color: #454549;
    color: #898989;
}

#btnResetMapeo {
    background-color: transparent;
    color: #FFFFFF;
    border: 1px solid #3E3E42;
    border-radius: 4px;
    padding: 8px 12px;
    font-family: Segoe UI;
    font-size: 12px;
}

#btnResetMapeo:hover {
    background-color: #333337;
    border-color: #1976D2;
}

#btnResetMapeo:disabled {
    color: #707070;
    border-color: #454549;
}

/* Seccion de columnas CSV */
#seccionColumnasCSV {
    background-color: #252526;
    border: 1px solid #3E3E42;
    border-radius: 6px;
}

#lblColumnasCSV {
    color: #B0B0B0;
    font-family: Segoe UI;
    font-size: 11px;
}
